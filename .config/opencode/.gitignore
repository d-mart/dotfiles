# OpenCode runtime-managed / volatile files - never commit
node_modules/

# Config-root artifacts generated by OpenCode (anchored so plugin dirs stay tracked)
/package.json
/package-lock.json
/bun.lock

# Local service auth (runtime-generated password)
/service.json

# Tool-generated sandbox config - intentionally untracked
/jail.json

# Runtime cache
/cache/

# GSD installer-managed files (regenerable via GSD installer)
/get-shit-done/
/gsd-file-manifest.json
/agents/
/command/
/hooks/
