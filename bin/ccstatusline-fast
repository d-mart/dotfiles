#!/usr/bin/env python3
# Claude Code status line: runs ccstatusline on the tail of the session
# transcript instead of the whole thing.
#
# Whenever the status JSON carries transcript_path, ccstatusline reads and
# JSON-decodes the whole transcript on every refresh, whatever widgets are
# configured. Long sessions grow transcripts of hundreds of MB, so each refresh
# cost ~10-15 CPU-seconds and a handful of sessions pinned the machine.
#
# This copies the last TAIL_BYTES of the transcript (from the first whole line)
# into a per-transcript cache directory and points transcript_path at that.
# Everything in ccstatusline that wants recent records -- idle detection for
# stale rate-limit data, context and effort fallbacks, session name, output
# speed -- still finds them; only whole-session sums (token totals) become
# tail sums, which is why the layout doesn't show those.
#
# The copy keeps the transcript's file name and sits next to symlinks to its
# subagents/ directories, because ccstatusline finds subagent transcripts
# relative to transcript_path; it reads only the ones the tail mentions. If the
# tail holds no assistant record (one huge tool result or image can fill it),
# the window doubles, up to MAX_TAIL_BYTES. An unchanged transcript is not
# copied again: the copy carries the transcript's mtime.
#
# ccstatusline is looked up as: $CCSTATUSLINE_BIN, else a global npm install
# under the newest asdf Node (run with that Node, so a project pinning another
# version neither hides nor breaks it), else ccstatusline on $PATH, else npx
# (works, but pays npm's startup and registry check on every refresh).
#
# Any failure in the copy falls back to dropping transcript_path, never to
# handing ccstatusline the full transcript.

import glob
import hashlib
import json
import os
import shutil
import sys
import tempfile
import time

TAIL_BYTES = 1048576
MAX_TAIL_BYTES = 8 * TAIL_BYTES
CACHE_TTL_SECONDS = 24 * 3600
ASSISTANT_RECORD = b'"type":"assistant"'


def cache_dir():
    base = os.environ.get("XDG_RUNTIME_DIR") or os.path.expanduser("~/.cache")
    path = os.path.join(base, "ccstatusline-fast")
    os.makedirs(path, mode=0o700, exist_ok=True)
    return path


def prune(directory):
    """Drop cache entries nobody has used for CACHE_TTL_SECONDS."""
    cutoff = time.time() - CACHE_TTL_SECONDS
    for entry in os.scandir(directory):
        try:
            if entry.stat(follow_symlinks=False).st_mtime >= cutoff:
                continue
            if entry.is_dir(follow_symlinks=False):
                shutil.rmtree(entry.path)  # unlinks the subagents symlinks, never follows them
            else:
                os.unlink(entry.path)
        except OSError:
            pass


def read_tail(path, size):
    """The whole lines in the last TAIL_BYTES of path's first `size` bytes,
    widened (up to MAX_TAIL_BYTES) until they include an assistant record."""
    window = TAIL_BYTES
    while True:
        with open(path, "rb") as fh:
            if size > window:
                fh.seek(size - window - 1)
                fh.readline()  # skip to the first whole line (the -1 keeps one that starts exactly at the cut)
            data = fh.read(max(size - fh.tell(), 0))
        if ASSISTANT_RECORD in data or window >= MAX_TAIL_BYTES or size <= window:
            return data
        window *= 2


def link_subagents(source, entry):
    """Symlink the transcript's subagents/ dirs where ccstatusline looks for them."""
    src_dir = os.path.dirname(source)
    stem = os.path.splitext(os.path.basename(source))[0]
    for rel in ("subagents", os.path.join(stem, "subagents")):
        real, link = os.path.join(src_dir, rel), os.path.join(entry, rel)
        if os.path.isdir(real) and not os.path.lexists(link):
            os.makedirs(os.path.dirname(link), exist_ok=True)
            try:
                os.symlink(real, link)
            except FileExistsError:
                pass  # a concurrent refresh got there first


def tail_copy(path):
    """Return a path holding the transcript's tail (or the path itself if small)."""
    st = os.stat(path)
    if st.st_size <= TAIL_BYTES:
        return path
    directory = cache_dir()
    prune(directory)
    entry = os.path.join(directory, hashlib.sha256(path.encode()).hexdigest()[:32])
    os.makedirs(entry, mode=0o700, exist_ok=True)
    os.utime(entry)  # in use: keep prune away
    link_subagents(path, entry)
    target = os.path.join(entry, os.path.basename(path))
    try:
        if os.stat(target).st_mtime_ns == st.st_mtime_ns:
            return target  # transcript unchanged since the last copy
    except FileNotFoundError:
        pass
    data = read_tail(path, st.st_size)
    fd, tmp = tempfile.mkstemp(dir=entry, suffix=".tmp")
    try:
        with os.fdopen(fd, "wb") as out:
            out.write(data)
        # Stamp the copy with the mtime of the transcript it was cut from; if
        # the transcript grew meanwhile, its mtime moves on and the next
        # refresh copies again.
        os.utime(tmp, ns=(st.st_atime_ns, st.st_mtime_ns))
        os.replace(tmp, target)  # atomic: concurrent refreshes never see a partial file
    except BaseException:
        os.unlink(tmp)
        raise
    return target


def version_key(path):
    version = path.split(os.sep)[-3]  # .../installs/nodejs/<version>/bin/ccstatusline
    return [int(p) if p.isdigit() else 0 for p in version.split(".")]


def ccstatusline_command():
    override = os.environ.get("CCSTATUSLINE_BIN")
    if override:
        return [override]
    installs = glob.glob(os.path.expanduser("~/.asdf/installs/nodejs/*/bin/ccstatusline"))
    if installs:
        script = max(installs, key=version_key)
        node = os.path.join(os.path.dirname(script), "node")
        return [node, script] if os.access(node, os.X_OK) else [script]
    found = shutil.which("ccstatusline")
    if found:
        return [found]
    return ["npx", "-y", "ccstatusline@latest"]


def rewrite(raw):
    try:
        data = json.loads(raw)
    except ValueError:
        return raw  # not ours to fix; let ccstatusline report it
    if not isinstance(data, dict) or not data.get("transcript_path"):
        return raw
    try:
        data["transcript_path"] = tail_copy(data["transcript_path"])
    except Exception:
        del data["transcript_path"]
    return json.dumps(data).encode()


def main():
    payload = rewrite(sys.stdin.buffer.read())
    # Hand the payload over as stdin and exec, so no Python lingers while
    # ccstatusline runs. An unlinked temp file rather than a pipe: no buffer
    # size to deadlock on, whatever the payload's size.
    stdin = tempfile.TemporaryFile()
    stdin.write(payload)
    stdin.flush()
    os.lseek(stdin.fileno(), 0, os.SEEK_SET)
    os.dup2(stdin.fileno(), 0)
    command = ccstatusline_command() + sys.argv[1:]
    os.execvp(command[0], command)


if __name__ == "__main__":
    main()
